# Copy to .env and fill in. Never commit .env.

# --- Claude (the Analyst, Copywriter and QC brains) ---
ANTHROPIC_API_KEY=

# --- Twitch (Scout + Analyst: VODs, community clips) ---
# Create an app at https://dev.twitch.tv/console/apps (category: Application Integration)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Instagram Reels (Publisher) ---
# Instagram professional (Business) account + long-lived token with instagram_content_publish
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- TikTok (Publisher) ---
# App at https://developers.tiktok.com with Content Posting API (video.publish / video.upload)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/callback/

# --- YouTube Shorts (Publisher) ---
# OAuth client JSON (Desktop app) from Google Cloud Console; run `clipfactory auth youtube` once
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
